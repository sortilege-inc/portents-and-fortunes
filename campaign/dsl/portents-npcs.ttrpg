            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 1", "Social 2", "Trade 4"]
            ^"Advantages" LIST OF STRING ["Wilderness Survival Knowledge: (water) Mental"]
            ^"Disadvantages" LIST OF STRING ["Obtuse: (air) Interpersonal, Mental"]
            ^"Gear" LIST OF STRING ["Passable clothes", "handful of bu"]
            ^"Epithet" STRING "The jovial one"
            ^"Affiliation" STRING "Arriving with the column"
            ^"Campaign Status" STRING "Arriving · good company · an unreliable witness to the current hour"
            ^"Biography" LIST OF STRING [
                "The most jovial of them. He enjoys getting a little high and reminiscing, and does not reliably keep hold of the present while he does it."
            ]
        }
        RULES {
