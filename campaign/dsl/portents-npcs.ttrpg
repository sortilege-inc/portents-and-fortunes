        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 3
            ^"Description" STRING "The most skilled pair of hands in the village, and the youngest voice on its bench. He works the way the patient work, and is quick to decide he has taken a man's measure."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 1
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 8
            ^"Focus" INTEGER 4
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 25
            ^"Glory" INTEGER 25
            ^"Status" INTEGER 9
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 0", "Scholar 2", "Social 2", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Daikoku's Blessing: (water) Social; Interpersonal, Spiritual"]
            ^"Disadvantages" LIST OF STRING ["Deferential: (water) Social; Interpersonal, Mental"]
            ^"Gear" LIST OF STRING ["Working clothes", "his tools", "handful of bu"]
            ^"Epithet" STRING "The craftsman"
            ^"Affiliation" STRING "White Flower Village · Perfect Land Sect"
            ^"Campaign Status" STRING "White Flower · craftsman · quick to trust · craft not yet named"
            ^"Biography" LIST OF STRING [
                "An expert craftsman. Never married. Late forties, and by far the youngest voice on the village's bench. Large through the shoulders, working apron, a cloth for his hands that ends up over one shoulder. He claps people he approves of.",
                "A convert to the Perfect Land Sect — and, since the stables, satisfied that Norikage is one as well. Every observation behind that conclusion was accurate. Only the conclusion is wrong."
            ]
        }
        RULES {
            #PFnpcHeisuker1: heisuke_i_can_fix_that "I Can Fix That: Can remove the Damaged condition from most non-supernatural items (rarity 6 or lower). GM determines repairability, cost, and time."
            #PFnpcHeisuker2: heisuke_trustworthy_cadence "Trustworthy Cadence (Title Ability): When making a social skill check targeting a character with status 20 or lower, reduce the TN by 1."
        }
    }

