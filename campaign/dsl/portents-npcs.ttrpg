            ^"Honor" INTEGER 50
            ^"Glory" INTEGER 45
            ^"Status" INTEGER 25
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 3", "Martial 1", "Scholar 2", "Social 3", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Indomitable Will: (air) Social; Mental"]
            ^"Disadvantages" LIST OF STRING ["Softheartedness: (fire) Social; Interpersonal"]
