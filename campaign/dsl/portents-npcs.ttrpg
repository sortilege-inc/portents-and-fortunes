        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 3
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Cheerful, weathered, and most present when talking about a time that is not this one."
            ^"Rings" DEF {
