EXTENSION "Portents_NPCs" EXTENDS "L5R5e_Core_NPCs" {
    NAME "Portents & Fortunes — the Dramatis Personae"
    VERSION "0.1.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-23"

    # The campaign's NPCs, each a DEF on the corpus's NPC chassis in the corpus's own field names
    # (l5r5e-0.5-core-npcs.ttrpg). Converted once from the old site's npcs.js by
    # campaign/source/convert_npcs.py; this file is now the source. A statblock built on a corpus
    # profile keeps that profile's values; a one-line ability is the 0.5 corpus's line where the
    # corpus prints it; a technique is a reference to the corpus's own entity. Epithet,
    # Affiliation, Campaign Status and Biography are the campaign's own record of the person.

    #PFnpcSeiyaMori ^"Seiya Mori" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 7
            ^"Intrigue Conflict Rank" INTEGER 6
            ^"Description" STRING "The typical daimyō is stern, serious, and inured to flattery. Their time is valuable, so they appreciate brevity and clarity from any samurai who address them. While most no longer take up arms often, they can be extremely deadly in battle, for they often possess arms and armor of surpassing quality and a lifetime of experience fighting to maintain what is theirs at court and in combat."
            ^"Rings" DEF {
                ^"Air" INTEGER 3
                ^"Earth" INTEGER 4
                ^"Fire" INTEGER 4
                ^"Water" INTEGER 4
                ^"Void" INTEGER 4
            }
            ^"Endurance" INTEGER 14
            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 4
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 70
            ^"Status" INTEGER 65
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 2", "Martial 4", "Scholar 3", "Social 3", "Trade 1"]
            ^"Advantages" LIST OF STRING ["Wisdom of Experience: (void) Scholar; Mental", "Bolstering Presence: (earth) Social; Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Long at Court: (water) Martial; Mental, Physical"]
            ^"Favored Weapons" LIST OF STRING ["Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Calligraphy set", "personal chop"]
            ^"Gear (Other)" LIST OF STRING ["Daishō", "plated armor (Physical 5, Cumbersome, Durable, Wargear)", "various estates"]
            ^"Epithet" STRING "Provincial Daimyō"
            ^"Affiliation" STRING "Dragon · Seiya (a vassal family of the Agasha)"
            ^"Campaign Status" STRING "Named, unmet · ordered the consolidation · Norikage observes it from outside his chain of command"
            ^"Biography" LIST OF STRING [
                "Lord of the province in which White Flower Village sits, and the hand behind the consolidation. Two or three villages of the province are being given up entirely, their remaining people divided among the settlements that can still carry them — and the order carries a daimyō's authority. The Seiya are a vassal family sworn to the Agasha, and through them to the Dragon; a daimyō of that line answers to Agasha interests while governing in their own name.",
                "The reasoning offered is arithmetic: the mountains are hard, the terraces are failing, and a village past a certain thinness costs more than it returns. Whether that is the whole of it, and on whose counsel it was decided, Norikage does not know. He walks with one of the displaced groups, but not under this lord's command."
            ]
        }
        RULES {
            #PFnpcSeiyaMorir1: seiya_mori_lord_s_command "Lord’s Command: Once per scene, as a Support action, a daimyō may advise a character who can hear them on how to complete a task they wish the character to perform. The character may use the daimyō’s ring or skill in place of their own for the next check they make to complete this task before the end of the game session."
        }
    }

    #PFnpcSeiyaFusae ^"Seiya Fusae" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "Bushi are warriors: armed samurai who are professional soldiers in service to their clan. PCs might encounter bushi individually, or they might meet an organized body, which could be anything from a squad (or guntai) of up to a dozen bushi commanded by a sergeant (or gunsō) to an entire army on the march."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 3
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 12
            ^"Composure" INTEGER 9
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 50
            ^"Status" INTEGER 39
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 1", "Martial 3", "Scholar 2", "Social 1", "Trade 0"]
            ^"Advantages" LIST OF STRING ["Tested in War: (earth) Martial; Mental, Physical", "Sworn to Bushidō: (void) Social; Mental"]
            ^"Disadvantages" LIST OF STRING ["Hot-Tempered: (water) Social; Mental"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged", "Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged", "Yumi (Bow): Range 2–5, Damage 5, Deadliness 3"]
            ^"Gear" LIST OF STRING ["Lacquered armor (Physical 4, Ceremonial, Cumbersome, Wargear)", "wakizashi", "quiver", "yari (spear)", "knife"]
            ^"Gear (Other)" LIST OF STRING ["Plain robes (Physical 1, Mundane)", "a handful of koku and bu"]
            ^"Epithet" STRING "Officer of the Escort"
            ^"Affiliation" STRING "Dragon · Seiya · Mirumoto Two-Heavens Adept, trained at Iron Mountain Dojo"
            ^"Campaign Status" STRING "On the road with him · commands the escort · silent on anything to do with the kami"
            ^"Biography" LIST OF STRING [
                "Twenty-two years old, and in command of the ashigaru walking the displaced households east to White Flower Village. The Seiya are a vassal family of the Agasha, and virtually every Dragon shugenja is Agasha — so a Seiya daughter who is not attuned to the kami cannot train with her own parent family. She went instead to Iron Mountain Dojo, the academy for most Dragon bushi and the center of excellence for niten, where instruction is famously unfocused by Rokugani standards and students are encouraged to follow their interests. She followed hers to the two-sword style.",
                "The result is an officer taught to fight one person extremely well, handed a column of families, carts and levies instead. The ashigaru under her are mostly older men; her authority over them rests on nothing but rank, because nothing in her education touches this work. She knows it, and so do they. She does not speak about religious matters at all — whether from caution or from ignorance, Norikage cannot yet tell. It is worth his considering that the silence may be his own doing: a monk sent by a temple, in a religious capacity, for reasons nobody explained to her, is an excellent reason to say nothing."
            ]
        }
        RULES {
            #PFnpcSeiyaFusaer1: seiya_fusae_two_heavens_style "Two Heavens Style: Once per round, when performing an Attack action, Fusae may spend (op) as follows: (op): Perform a Strike Action with a readied weapon she has not used for an Attack action this turn."
            #PFnpcSeiyaFusaer2: seiya_fusae_crescent_moon_style "Crescent Moon Style: When performing a Guard action (see page 264), the bushi may spend (op) in the following way: (op): After another character performs an Attack action targeting the bushi or another character the bushi is guarding, the bushi may perform a Strike action targeting them. This effect persists until the start of the bushi’s next turn or until they perform a Strike action."
            #PFnpcSeiyaFusaer3: seiya_fusae_sworn_protector "Sworn Protector: Once per scene, when an Attack action check targeting another character at range 0–1 succeeds, a bushi may intervene, becoming the target of the action instead."
        }
    }

    #PFnpcGenzo ^"Genzō" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 2
            ^"Intrigue Conflict Rank" INTEGER 2
            ^"Description" STRING "A man of the emptied village, walking east with what he could carry. He speaks for people who no longer have a place to speak for."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 2
                ^"Water" INTEGER 2
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 20
            ^"Glory" INTEGER 23
            ^"Status" INTEGER 9
            ^"Demeanor" STRING "Shrewd"
            ^"Social Skill Check TN Modifiers" STRING "Air +2, Fire -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 1", "Scholar 1", "Social 3", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Indomitable Will: (earth) Interpersonal, Mental"]
            ^"Disadvantages" LIST OF STRING ["Fear of Death: (earth) Mental, Physical"]
            ^"Gear" LIST OF STRING ["Passable clothes", "handful of bu"]
            ^"Epithet" STRING "Of the village being given up"
            ^"Affiliation" STRING "Arriving with the column · Perfect Land Sect"
            ^"Campaign Status" STRING "Arriving · cut off from his ancestors · took the kie"
            ^"Biography" LIST OF STRING [
                "The removal has broken him. His farm was in the village being given up, and his ancestors are buried there. His difficulty is practical before it is theological: he is a Fortunist who does not know the spirits of the place he is being sent to, and who no longer has access to his own dead.",
                "What he was before the order came is legible only in what is left of it.",
                "He is a devotee of the Perfect Land Sect. Norikage read the kie off his lips at a distance, given back to Ume in greeting — which is how a line of carts became a welcome without anyone in authority deciding anything."
            ]
        }
        RULES {
            #PFnpcGenzor1: genzo_overlooked "Overlooked: When the clever innkeeper makes a check targeting a character with a higher status rank, the innkeeper treats the target's vigilance as 1 lower."
        }
    }

    #PFnpcKiyo ^"Kiyo" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "A widow who has decided, out loud and repeatedly, that this can be borne. Half the column finds that steadying and the other half finds it unbearable."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 20
            ^"Glory" INTEGER 23
            ^"Status" INTEGER 9
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 2", "Social 3", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Inspiring: (water) Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Softheartedness: (fire) Interpersonal, Mental"]
            ^"Gear" LIST OF STRING ["Passable clothes", "handful of bu"]
            ^"Epithet" STRING "Widow of the column"
            ^"Affiliation" STRING "Arriving with the column"
            ^"Campaign Status" STRING "Arriving · argues the move's necessity · the bridge between benches"
            ^"Biography" LIST OF STRING [
                "A widow in her fifties. She holds that the move is logically necessary and is working to see the good in it, which makes her the easiest of the arriving three for a samurai to deal with. A shameless flirt."
            ]
        }
        RULES {
            #PFnpcKiyor1: kiyo_overlooked "Overlooked: When the clever innkeeper makes a check targeting a character with a higher status rank, the innkeeper treats the target's vigilance as 1 lower."
        }
    }

    #PFnpcRokuro ^"Rokurō" DEF {
