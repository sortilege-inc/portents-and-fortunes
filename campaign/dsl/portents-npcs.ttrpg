    #PFnpcUme ^"Ume" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Minion" FIXED
            ^"Combat Conflict Rank" INTEGER 1
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "A bereaved mother who stopped waiting for the Fortunes to be fair, and found a doctrine that promised the reward without the waiting."
            ^"Rings" DEF {
                ^"Air" INTEGER 2
                ^"Earth" INTEGER 2
                ^"Fire" INTEGER 1
                ^"Water" INTEGER 3
                ^"Void" INTEGER 1
            }
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 7
            ^"Focus" INTEGER 3
            ^"Vigilance" INTEGER 2
            ^"Honor" INTEGER 20
            ^"Glory" INTEGER 23
            ^"Status" INTEGER 9
            ^"Demeanor" STRING "Assertive"
            ^"Social Skill Check TN Modifiers" STRING "Earth +2, Air -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 0", "Scholar 2", "Social 3", "Trade 3"]
            ^"Advantages" LIST OF STRING ["Indomitable Will: (earth) Interpersonal, Mental"]
            ^"Disadvantages" LIST OF STRING ["Impatience: (earth) Mental"]
            ^"Gear" LIST OF STRING ["Passable clothes", "handful of bu"]
            ^"Epithet" STRING "First of the sect"
            ^"Affiliation" STRING "White Flower Village · Perfect Land Sect · married to Tōbei"
            ^"Campaign Status" STRING "White Flower · first convert · opened the village to the newcomers"
            ^"Biography" LIST OF STRING [
                "Married to Tōbei. They had a child, and the child died. She is the first convert to the Perfect Land Sect in White Flower Village.",
                "Demanding and jealous, with little confidence underneath it, and willing to bully people into agreeing with her from a position of pity.",
                "Sour-faced, and strongly and vocally against the arrival — she argued it with Sadao in front of an outside monk on the first day.",
                "She reversed herself the moment she found her own faith among the newcomers, walked the line taking the measure of all three arriving elders, and ended the argument herself: they are staying. She stands at Sadao's shoulder as his equal in public, which a commoner does not do, and he does not dispute it."
            ]
        }
        RULES {
            #PFnpcUmer1: ume_overlooked "Overlooked: When the clever innkeeper makes a check targeting a character with a higher status rank, the innkeeper treats the target's vigilance as 1 lower."
            #PFnpcUmer2: ume_trustworthy_cadence "Trustworthy Cadence (Title Ability): When making a social skill check targeting a character with status 20 or lower, reduce the TN by 1."
        }
    }

    #PFnpcKitsukiSadao ^"Kitsuki Sadao" DEF {
        EXTENDS #t4540de6f35155c46f41f0 ^"NPC"

        PROPERTIES {
            ^"Type" STRING "Adversary" FIXED
            ^"Combat Conflict Rank" INTEGER 4
            ^"Intrigue Conflict Rank" INTEGER 4
            ^"Description" STRING "A Kitsuki grown old a long way from anywhere the Kitsuki are needed. The eye is undimmed; everything holding it up is not."
            ^"Rings" DEF {
                ^"Air" INTEGER 4
                ^"Earth" INTEGER 3
                ^"Fire" INTEGER 3
                ^"Water" INTEGER 5
                ^"Void" INTEGER 2
            }
            ^"Endurance" INTEGER 5
            ^"Composure" INTEGER 16
            ^"Focus" INTEGER 7
            ^"Vigilance" INTEGER 5
            ^"Honor" INTEGER 55
            ^"Glory" INTEGER 62
            ^"Status" INTEGER 47
            ^"Demeanor" STRING "Gruff"
            ^"Social Skill Check TN Modifiers" STRING "Water +2, Earth -2"
            ^"Skills" LIST OF STRING ["Artisan 0", "Martial 3", "Scholar 4", "Social 4", "Trade 2"]
            ^"Advantages" LIST OF STRING ["Student of Law: (water) Scholar; Mental", "Seasoned: (void) Mental, Interpersonal"]
            ^"Disadvantages" LIST OF STRING ["Conflicted: (fire) Social; Mental", "Impatience: (earth) Mental"]
            ^"Favored Weapons" LIST OF STRING ["Katana: Range 1, Damage 4, Deadliness 5/7, Ceremonial, Razor-Edged", "Wakizashi: Range 0–1, Damage 3, Deadliness 5/7, Ceremonial, Razor-Edged"]
            ^"Gear" LIST OF STRING ["Lacquered Armor (Physical 4, Ceremonial, Cumbersome, Wargear)"]
            ^"Epithet" STRING "The old magistrate"
            ^"Affiliation" STRING "White Flower Village · Dragon · Kitsuki · Fortunist"
            ^"Campaign Status" STRING "White Flower · the only samurai resident · a Fortunist who has not noticed the sect"
            ^"Biography" LIST OF STRING [
                "A samurai of the Kitsuki, and very old. A Fortunist. Two children, both grown, both living far away.",
                "Impatience and a mercurial temper have alienated nearly everyone in the village except one neighbour, who is deaf and keeps him company regardless.",
                "A Fortunist of the ordinary observant sort — no formal training, but decades of drinking with pilgrims on the road north, and the vocabulary of a man for whom the celestial order is simply how things are. He does not know the sect is inside his village.",
                "Seventies or eighties, hunched over a stout walking stick. The wakizashi at his belt is what marks him samurai in a village of peasants. Formerly something like a regional administrator; he has worked this province his whole career and dislikes travel. The two children are in the southern Dragon lands — one in the Kitsuki provinces, one an Emerald Magistrate whose letters arrive from as far as Crab lands. His temper flares and then goes out of him, too tired to reach outrage. It is not personal."
            ]
        }
        RULES {
            #PFnpcKitsukiSadaor1: kitsuki_sadao_a_keen_eye "A Keen Eye: Always uses Focus as base initiative value."
        }
    }

    #PFnpcHeisuke ^"Heisuke" DEF {
